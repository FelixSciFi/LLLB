[
  {
    "id": "6fd04b5a-c156-44d9-a2f1-980410a751e9",
    "text": "C'est trop.",
    "cefr": "A1"
  },
  {
    "id": "fdba2676-1b45-432d-8c23-03967a91a1fd",
    "text": "Je suis fatigué.",
    "cefr": "A1"
  },
  {
    "id": "2f1eb150-7c47-4878-be75-934ae2ee29d5",
    "text": "Je suis malade.",
    "cefr": "A1"
  },
  {
    "id": "4aa1817e-e9dd-4c92-a897-c6c4114496eb",
    "text": "Je voudrais prendre un rendez-vous.",
    "cefr": "A2"
  },
  {
    "id": "9b72fe2a-d5da-44de-8f76-1463b9664e02",
    "text": "J'étais occupé.",
    "cefr": "A2"
  },
  {
    "id": "2bf3bb16-de3f-46c2-8762-ac2e865bbf7e",
    "text": "Encore !",
    "cefr": "A1"
  },
  {
    "id": "7c5b5393-823f-407e-864c-62ada6d1de6e",
    "text": "Prends soin de toi.",
    "cefr": "A2"
  },
  {
    "id": "f69b8137-5fec-4dbb-80fb-e93dc430f212",
    "text": "Pas de souci.",
    "cefr": "A2"
  },
  {
    "id": "ed98b07a-055f-4d7f-be5e-1a8745dcf062",
    "text": "Ne m'attendez pas.",
    "cefr": "A2"
  },
  {
    "id": "94274fa9-93d8-411f-a0e1-c12667500406",
    "text": "Je vais essayer.",
    "cefr": "A2"
  },
  {
    "id": "7db1db99-0d9e-4b12-a1c2-eecfd1b0250f",
    "text": "À plus tard !",
    "cefr": "A1"
  },
  {
    "id": "f5674e48-a461-45b9-acd4-2d502b93c590",
    "text": "J'ai hâte de te revoir.",
    "cefr": "B1"
  }
]