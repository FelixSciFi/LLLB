[
  {
    "id": "5075390b-68f0-4c52-a153-cbaa06f214b8",
    "text": "On rigole bien.",
    "cefr": "A2"
  },
  {
    "id": "6fe9ac8e-986e-4b7d-a503-c10f4af94094",
    "text": "On attend la sonnerie.",
    "cefr": "A2"
  },
  {
    "id": "d5554e78-1d01-4d4d-878e-34a1acf67a0d",
    "text": "C'est l'heure de la récré.",
    "cefr": "A1"
  },
  {
    "id": "d1e17d57-97d0-461c-a936-79a23cec6a62",
    "text": "Mettez-vous en rang, s'il vous plaît.",
    "cefr": "A2"
  },
  {
    "id": "7113534a-824f-4c96-a455-fdcd49f1eb09",
    "text": "On aime dessiner et chanter.",
    "cefr": "A1"
  },
  {
    "id": "b446893f-1ca8-4b31-aed2-d51bf8923139",
    "text": "Viens à l'école avec moi.",
    "cefr": "A1"
  },
  {
    "id": "dba26606-385a-4df3-8b02-afa511779060",
    "text": "C'est l'autre maîtresse aujourd'hui.",
    "cefr": "A2"
  },
  {
    "id": "f79dabfe-2e41-419c-a1dd-b8de9365afe0",
    "text": "Au revoir maman !",
    "cefr": "A1"
  },
  {
    "id": "33a3cab4-b7db-46e1-9358-eac75cf017a6",
    "text": "Allez, dépêche-toi !",
    "cefr": "A2"
  },
  {
    "id": "3c3f3e42-160d-443c-ab48-f4d6e2c39412",
    "text": "Vas-y !",
    "cefr": "A1"
  },
  {
    "id": "991de57d-5d92-4f38-8a35-c7f315e15271",
    "text": "But !",
    "cefr": "A1"
  },
  {
    "id": "c14276b8-39a8-4502-89e6-ddee211ccda9",
    "text": "La maîtresse est malade.",
    "cefr": "A1"
  }
]