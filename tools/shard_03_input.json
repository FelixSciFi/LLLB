[
  {
    "id": "aefaf17b-b6c4-4ca3-af79-03b00c348805",
    "text": "Je lis rarement le journal.",
    "cefr": "A2"
  },
  {
    "id": "82da3b77-da48-48d7-bb99-49df93e51097",
    "text": "Combien coûte une douzaine d'œufs?",
    "cefr": "A1"
  },
  {
    "id": "5e329248-ebf5-4474-9ad8-8c92c53a5212",
    "text": "J'ai oublié mon mot de passe.",
    "cefr": "A2"
  },
  {
    "id": "4a7b0fd2-c440-43e9-989c-2547939bc8c2",
    "text": "Je me promène.",
    "cefr": "A2"
  },
  {
    "id": "bba5f04a-0c0c-41b9-9153-fae3efdcf0a0",
    "text": "C'est indispensable.",
    "cefr": "B2"
  },
  {
    "id": "67aac379-bb9b-4847-b679-49b01735ddb7",
    "text": "Nonobstant ce refus.",
    "cefr": "C1"
  },
  {
    "id": "7b520031-e19f-4253-9f46-a60afc700ee4",
    "text": "L'aléa l'emporte.",
    "cefr": "C2"
  },
  {
    "id": "7e873751-5f70-4e79-a4b4-6fab64b53eb1",
    "text": "Le vide laissé par quelqu'un ne disparaît pas facilement.",
    "cefr": "B2"
  },
  {
    "id": "43c1fd2e-f674-4f64-b6cc-2ee5e6be845a",
    "text": "C'est une lucidité qui fait mal.",
    "cefr": "B2"
  },
  {
    "id": "4a2a19d7-98f6-42f8-9af5-941a5a0408ca",
    "text": "L'usure imperceptible du quotidien finit par épuiser.",
    "cefr": "C1"
  },
  {
    "id": "7f9f2dee-ffcd-4eea-9c20-4e6545804e37",
    "text": "Je marche vers l'école.",
    "cefr": "A1"
  },
  {
    "id": "f615b877-5172-410b-b9af-b0851f524a1d",
    "text": "On travaille tous ensemble.",
    "cefr": "A1"
  }
]