[
  {
    "id": "2ca33307-0aec-4da3-9c92-2955ca0a20ee",
    "text": "Quelle heure est-il ?",
    "cefr": "A1"
  },
  {
    "id": "5385bf9d-bb0d-48ab-8470-653a5ed11e0e",
    "text": "Il est vingt-trois heures.",
    "cefr": "A1"
  },
  {
    "id": "744eeb99-ab63-43d5-84da-5472a0ebf78f",
    "text": "Un canapé confortable.",
    "cefr": "A1"
  },
  {
    "id": "a2f373ae-7cf0-4227-a77c-84a9df6b69df",
    "text": "Une télévision.",
    "cefr": "A1"
  },
  {
    "id": "e8d79d62-2bb9-430f-a6f2-134d2f089872",
    "text": "Un ordinateur portable.",
    "cefr": "A1"
  },
  {
    "id": "5d6bc943-9284-446c-b6b5-016740ff7e82",
    "text": "La baignoire et le miroir dans la salle de bain.",
    "cefr": "A1"
  },
  {
    "id": "4c51792c-e4be-4d4d-a9e5-1e82176e5487",
    "text": "Une souris sans fil.",
    "cefr": "A1"
  },
  {
    "id": "bc25e36d-8094-4340-b220-d35d17e1b88f",
    "text": "Le clavier.",
    "cefr": "A1"
  },
  {
    "id": "69e8c723-a1d8-4d8b-8959-252d2b0e2c7a",
    "text": "L'alimentation de l'ordinateur.",
    "cefr": "A2"
  },
  {
    "id": "889b4836-92fe-4c13-9a54-63dc2d219793",
    "text": "À vendre.",
    "cefr": "A1"
  },
  {
    "id": "290a3700-80e7-4171-bcca-394c4a0ab4c1",
    "text": "Plusieurs millions.",
    "cefr": "A2"
  },
  {
    "id": "6dad7cc5-17cc-4b32-a6a4-4e6706a3af38",
    "text": "Quelle est votre voiture ? Celle au milieu.",
    "cefr": "A1"
  }
]