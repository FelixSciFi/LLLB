[
  {
    "id": "afb6b74d-c795-4c49-ab09-ea89bfdb1aa0",
    "text": "Je suis occupé.",
    "cefr": "A1"
  },
  {
    "id": "c7f9f880-a438-4e17-aa5c-7a35dbeed09d",
    "text": "Vous étiez là ?",
    "cefr": "A2"
  },
  {
    "id": "dd47ebdc-aba9-40ed-ba5b-1655dba0281b",
    "text": "C'était comment ?",
    "cefr": "A2"
  },
  {
    "id": "b183bc0c-c2b2-4bbe-92c1-963c5476609f",
    "text": "Vous avez vu quelque chose ?",
    "cefr": "A2"
  },
  {
    "id": "8262ae87-001b-41d2-a5cd-e3d16eb3bb0d",
    "text": "Depuis combien de temps ?",
    "cefr": "A2"
  },
  {
    "id": "6d438351-c5a8-45d2-b760-1a2b024e9747",
    "text": "C'est grave ?",
    "cefr": "A2"
  },
  {
    "id": "abfd5b9b-2642-4e12-8b4f-39de54663e20",
    "text": "Qu'est-ce que vous en pensez ?",
    "cefr": "A2"
  },
  {
    "id": "aa882ae5-c3e8-4895-9000-4814efb46ce4",
    "text": "Ça fait mal ?",
    "cefr": "A2"
  },
  {
    "id": "c15501bb-845a-4268-aec2-12ceb02c6193",
    "text": "Vous êtes d'accord ?",
    "cefr": "A2"
  },
  {
    "id": "7e26114c-ab3a-4c27-8338-2316b10076cf",
    "text": "Et maintenant ?",
    "cefr": "A1"
  },
  {
    "id": "fb264330-3528-42dc-a684-54b616d0e7b3",
    "text": "Un ingénieur chinois.",
    "cefr": "A1"
  },
  {
    "id": "c6b328a9-1f39-4ba0-9fcb-179291b2e641",
    "text": "Une infirmière française.",
    "cefr": "A1"
  }
]