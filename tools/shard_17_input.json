[
  {
    "id": "606a130a-3d5d-4e6a-9ada-e5c221fe9a29",
    "text": "Le citron est très acide.",
    "cefr": "A2"
  },
  {
    "id": "739bbc99-70b9-4cc3-a93f-075a35753bcd",
    "text": "Le sucre est doux.",
    "cefr": "A1"
  },
  {
    "id": "41fe884d-5380-47d8-83fd-722599b99666",
    "text": "Le médicament est amer.",
    "cefr": "A2"
  },
  {
    "id": "4fc9a432-cb0a-410a-ac0e-23908ae405f9",
    "text": "Le sel est salé.",
    "cefr": "A1"
  },
  {
    "id": "5554eca7-3170-489e-9757-d1c395f0eda4",
    "text": "Mon ancien téléphone ramait tout le temps.",
    "cefr": "B1"
  },
  {
    "id": "8f178555-bd82-4d62-b40f-39d8c559da25",
    "text": "Avec mon nouveau téléphone, ça ne rame plus.",
    "cefr": "B1"
  },
  {
    "id": "6f1e46f9-a94b-4cf5-8439-e95fc621adf2",
    "text": "Je suis en avance.",
    "cefr": "A2"
  },
  {
    "id": "f47bf966-7256-4bca-a316-d0e86f166137",
    "text": "Je suis à l'heure.",
    "cefr": "A2"
  },
  {
    "id": "3162c0a0-a1f4-44c7-a46a-00fe65d4bb7d",
    "text": "Il y a huit planètes dans le système solaire.",
    "cefr": "B1"
  },
  {
    "id": "6e0d92ac-c817-49d3-a960-21bb90d2bf1e",
    "text": "La semaine compte sept jours.",
    "cefr": "A1"
  },
  {
    "id": "a8850d16-6c8e-4639-b525-0d1e6a415089",
    "text": "Il y a onze joueurs dans une équipe de football.",
    "cefr": "A2"
  },
  {
    "id": "e72c0317-78d5-4d2e-8e72-e4629f4e1a77",
    "text": "Il y a soixante minutes dans une heure.",
    "cefr": "A1"
  }
]