[
  {
    "id": "35f499b1-5ecb-4bb5-b3d0-ab0cbb0d451d",
    "text": "C'est moi qui la remplace.",
    "cefr": "A2"
  },
  {
    "id": "4cdce51e-1f74-432c-83d1-f219aff8dd33",
    "text": "Vous me montrez votre classe ?",
    "cefr": "A1"
  },
  {
    "id": "a78ed32c-d1c2-471f-801f-5648f5019982",
    "text": "On va travailler maintenant.",
    "cefr": "A1"
  },
  {
    "id": "75e95120-dd33-4a2d-b738-c57a46ce2988",
    "text": "Je n'ai jamais vu ça.",
    "cefr": "A2"
  },
  {
    "id": "3df0273a-e3dc-4fb7-9f63-fbb273912132",
    "text": "Je ne vais pas changer les habitudes.",
    "cefr": "A2"
  },
  {
    "id": "d3d0264e-f33d-4f5a-8b11-14860a8655b7",
    "text": "Retournez en classe.",
    "cefr": "A1"
  },
  {
    "id": "3caa13dc-1bd7-44f1-a4b2-6caaaf583576",
    "text": "Au travail maintenant.",
    "cefr": "A1"
  },
  {
    "id": "9f8012b5-560b-4f5f-83b8-ebfbabdf1173",
    "text": "On se calme !",
    "cefr": "A2"
  },
  {
    "id": "5b57f1f9-f3a2-4a89-ba4b-be14a0c3a319",
    "text": "C'est pas très gentil.",
    "cefr": "A2"
  },
  {
    "id": "9dc06188-f310-4cc1-9eec-58e931f94782",
    "text": "Je me doutais bien.",
    "cefr": "B1"
  },
  {
    "id": "64e79b04-9c12-408e-8be0-9961c969e91f",
    "text": "Je ne suis pas content.",
    "cefr": "A1"
  },
  {
    "id": "d1263e5a-eb3d-4a49-ac0c-08872f00e719",
    "text": "J'ai pas envie.",
    "cefr": "A2"
  }
]