[
  {
    "id": "55593b30-6fb9-411f-8d76-b2c571c00bf6",
    "text": "Venez me rejoindre.",
    "cefr": "A2"
  },
  {
    "id": "b1114ab9-0f49-405d-b9ab-eaa198be2908",
    "text": "Qui la remplace ?",
    "cefr": "A2"
  },
  {
    "id": "65010f8c-6742-47fa-927e-3fa71a448797",
    "text": "Quel est ton prénom ?",
    "cefr": "A1"
  },
  {
    "id": "a06852b8-1525-4dd7-89cb-e0b75967304e",
    "text": "Je vais distribuer les feuilles.",
    "cefr": "A2"
  },
  {
    "id": "d6d01631-5547-4e5e-ba47-d99222091048",
    "text": "Voici ton cahier du jour.",
    "cefr": "A2"
  },
  {
    "id": "c6f53e25-706b-4f60-9c26-5b92f5e2793f",
    "text": "Au travail maintenant !",
    "cefr": "A2"
  },
  {
    "id": "7574bf77-e06d-4891-8dfb-e27599b717c9",
    "text": "La pauvre !",
    "cefr": "A2"
  },
  {
    "id": "716089d2-775e-4817-b327-f5c14e782677",
    "text": "Youpi !",
    "cefr": "A1"
  },
  {
    "id": "3afcfe5a-1892-4a50-b51e-735d3e150b7e",
    "text": "C'est pas grave.",
    "cefr": "A1"
  },
  {
    "id": "861a9566-022d-4718-9edb-fe9320614d73",
    "text": "On se calme !",
    "cefr": "A2"
  },
  {
    "id": "5b63df77-a59a-4bfd-a69d-b6a4b5374903",
    "text": "Tu racontes des bêtises.",
    "cefr": "A2"
  },
  {
    "id": "f776a5fc-9a11-4c0f-80a8-7febea929dbd",
    "text": "C'est pas très gentil.",
    "cefr": "A1"
  }
]