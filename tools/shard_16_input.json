[
  {
    "id": "8803bc6a-3a44-4f0b-90c1-1a2b213713bf",
    "text": "Je ressens de la joie.",
    "cefr": "A2"
  },
  {
    "id": "4154bc53-2885-476a-83a5-6d3a8179176a",
    "text": "Je suis content.",
    "cefr": "A1"
  },
  {
    "id": "3bef51ea-f536-4b21-8739-ef926109572a",
    "text": "Il ressent de l'excitation.",
    "cefr": "B1"
  },
  {
    "id": "494dee3b-52ab-4c53-9b12-a95f95b26760",
    "text": "Il a de la fierté.",
    "cefr": "B1"
  },
  {
    "id": "8501e926-cf8b-4ecd-af55-7aea3fd23e0e",
    "text": "Je suis en réflexion.",
    "cefr": "B1"
  },
  {
    "id": "c6e01a3b-b541-4e1c-884f-9162442687d9",
    "text": "Je ressens de la gêne.",
    "cefr": "B1"
  },
  {
    "id": "6122fab1-eb8e-42a5-ab61-202df84f697c",
    "text": "Je ressens de la déception.",
    "cefr": "B1"
  },
  {
    "id": "630bf918-fd47-44a5-a803-03bf2de247f3",
    "text": "Je suis en pleurs.",
    "cefr": "B1"
  },
  {
    "id": "95c4dd16-4c63-425e-b2b2-b13c70b0128d",
    "text": "Il ressent de la colère.",
    "cefr": "B1"
  },
  {
    "id": "84252683-2cdd-4922-91ea-bbc8cfb45248",
    "text": "Il a de la rage.",
    "cefr": "B1"
  },
  {
    "id": "fc6abe76-5e02-4d4f-9f29-420029184056",
    "text": "J'ai sommeil.",
    "cefr": "A1"
  },
  {
    "id": "7925e7c4-9d48-4159-9731-3327962e0d6c",
    "text": "Pour ce problème, il y a deux solutions.",
    "cefr": "A2"
  }
]