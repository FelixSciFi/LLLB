[
  {
    "id": "73ee50a4-4518-46a0-a4f0-ff6792ec13a4",
    "text": "C'est qui ?",
    "cefr": "A1"
  },
  {
    "id": "707f36d3-9f10-440f-a79f-f79a1d9149b2",
    "text": "Je m'appelle Marie.",
    "cefr": "A1"
  },
  {
    "id": "61371f03-dd34-4523-82ac-f55d23e982b7",
    "text": "Pas du tout !",
    "cefr": "A1"
  },
  {
    "id": "e3f365d3-2459-4161-99bc-b3e309451a14",
    "text": "Venez ici.",
    "cefr": "A1"
  },
  {
    "id": "99155d43-1b14-4d00-8291-9a21a485e52e",
    "text": "Pardon.",
    "cefr": "A1"
  },
  {
    "id": "ce20664a-d633-496e-8c3e-616e6d78c85f",
    "text": "Elle va me manquer.",
    "cefr": "A2"
  },
  {
    "id": "54d8c43b-c6d8-4fb4-9d4d-651427b91382",
    "text": "C'est qui ?",
    "cefr": "A1"
  },
  {
    "id": "7a1c6fc4-b702-4693-9d5f-54ec1081e45a",
    "text": "Quel est ton prénom ?",
    "cefr": "A1"
  },
  {
    "id": "2b101428-c9df-45e7-9e4a-5a28619fcbd7",
    "text": "Tu ne sais plus comment tu t'appelles ?",
    "cefr": "A2"
  },
  {
    "id": "cac1a179-ff73-4d09-ad68-5593f63c26c4",
    "text": "Ça te va très bien.",
    "cefr": "A2"
  },
  {
    "id": "8c4cf159-0b0f-480f-a339-c4f3549a250e",
    "text": "C'est joli comme prénom.",
    "cefr": "A2"
  },
  {
    "id": "58d10eac-e7a5-40f1-941e-86e68c7fe4e3",
    "text": "Elle a un gros rhume.",
    "cefr": "A1"
  }
]