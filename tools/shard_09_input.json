[
  {
    "id": "3055ed21-1b89-4bde-9f28-6828dc353199",
    "text": "Je vais vous expliquer.",
    "cefr": "A2"
  },
  {
    "id": "28b1285e-f5ee-4011-8044-80f9091b3e48",
    "text": "Venez immédiatement.",
    "cefr": "A2"
  },
  {
    "id": "c9c09812-6323-47a7-9032-90ad08463000",
    "text": "Doucement !",
    "cefr": "A1"
  },
  {
    "id": "e4c3b33f-df84-4c1e-b9bb-5b560cd1d042",
    "text": "Il peut pas sortir.",
    "cefr": "A2"
  },
  {
    "id": "c5c460f6-fd14-4072-a929-60d3aa7c2e6b",
    "text": "Qu'est-ce que tu racontes ?",
    "cefr": "A2"
  },
  {
    "id": "41ff8a05-dbc1-437c-841f-b968d49e9bf9",
    "text": "C'est dans le coffre.",
    "cefr": "A2"
  },
  {
    "id": "43e1c5e5-72bc-49f3-8a62-48b7febc5768",
    "text": "Vas vérifier !",
    "cefr": "A2"
  },
  {
    "id": "438ba036-c77c-42a4-b257-87d37029ee56",
    "text": "Je fais ça pas pour m'amuser.",
    "cefr": "B1"
  },
  {
    "id": "8f57ae31-6596-44b3-873d-09cb23c8bfa0",
    "text": "J'étais en route pour l'hôpital.",
    "cefr": "A2"
  },
  {
    "id": "a487f8cb-9e09-484c-8810-0cdceeb3537b",
    "text": "Je suis là pour ça.",
    "cefr": "A2"
  },
  {
    "id": "4ef9f39e-94df-43a1-a78c-ff3a986ba5d9",
    "text": "Vas-y !",
    "cefr": "A1"
  },
  {
    "id": "9b918e32-6b9f-4490-bfb2-24ca12530877",
    "text": "Comment t'appelles-tu ?",
    "cefr": "A1"
  }
]