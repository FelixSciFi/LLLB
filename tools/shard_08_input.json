[
  {
    "id": "d0c983a0-13fa-44de-ac94-63032922ec50",
    "text": "Ah bon ? C'est vrai ?",
    "cefr": "A1"
  },
  {
    "id": "8192be0e-49d1-4d29-8d00-864fda9be12b",
    "text": "Mais si, c'est vrai !",
    "cefr": "A1"
  },
  {
    "id": "4e375d6c-2d23-4ff0-b070-b7f903b8f6e1",
    "text": "Comment ça ?",
    "cefr": "A1"
  },
  {
    "id": "554d87d2-8558-4f4d-8a31-6c8b03c6da6b",
    "text": "Qu'est-ce qu'ils vous ont raconté ?",
    "cefr": "A2"
  },
  {
    "id": "d9373a35-7ffa-4fbe-a81f-8bf7fc0cd8cc",
    "text": "Par ici.",
    "cefr": "A1"
  },
  {
    "id": "3ef769c0-3d52-43cc-a01c-fd2901120396",
    "text": "Dégage-toi !",
    "cefr": "A2"
  },
  {
    "id": "d0d081f8-2e09-4ccf-8762-074ad73f2c8d",
    "text": "Ça y est !",
    "cefr": "A2"
  },
  {
    "id": "4962e9d7-f103-411d-9e3f-efd80e2d8ae7",
    "text": "Les voilà !",
    "cefr": "A1"
  },
  {
    "id": "37053ffc-0ef8-48ca-80c5-b81a72eced85",
    "text": "Vous êtes en forme !",
    "cefr": "A2"
  },
  {
    "id": "9fbd672d-b29a-42b7-abab-a5c3e4697807",
    "text": "Sortez du véhicule !",
    "cefr": "A2"
  },
  {
    "id": "d264f8d8-5e6b-461f-b05a-b2902cf5e37d",
    "text": "Vous allez encore perdre.",
    "cefr": "A2"
  },
  {
    "id": "a26b28de-82d6-47cc-8de2-3ae28de6f991",
    "text": "Tenu !",
    "cefr": "B1"
  }
]